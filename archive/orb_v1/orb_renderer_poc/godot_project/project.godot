; Engine configuration file.
; Jairus Orb Renderer PoC — throwaway/experimental, see ../README.md.
; Validates ORB_RENDERER_INVESTIGATION.md's recommendation. Not part of
; the real Jairus application in any way.

config_version=5

[application]

config/name="Jairus Orb Renderer PoC"
run/main_scene="res://orb_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=480
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="disabled"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
textures/vram_compression/import_etc2_astc=true
